datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
}

enum SkillCategory {
  FRONTEND
  BACKEND
  DATABASE
  MOBILE
  AI_ML
  DEVOPS
  TOOLS
}

enum ContactStatus {
  UNREAD
  READ
  ARCHIVED
  SPAM
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  title        String
  bio          String    @db.Text
  avatarUrl    String?
  resumeUrl    String?
  githubUrl    String?
  linkedinUrl  String?
  twitterUrl   String?
  role         Role      @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
}

model Project {
  id           String             @id @default(uuid())
  title        String
  slug         String             @unique
  tagline      String
  description  String             @db.Text
  thumbnailUrl String
  demoUrl      String?
  repoUrl      String?
  featured     Boolean            @default(false)
  sortOrder    Int                @default(0)
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills       ProjectsOnSkills[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([featured, sortOrder])
}

model Skill {
  id          String             @id @default(uuid())
  name        String             @unique
  category    SkillCategory
  icon        String?
  proficiency Int?
  sortOrder   Int                @default(0)
  projects    ProjectsOnSkills[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([category, sortOrder])
}

model ProjectsOnSkills {
  projectId String
  skillId   String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
}

model Contact {
  id        String        @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String        @db.Text
  ipAddress String?
  userAgent String?
  status    ContactStatus @default(UNREAD)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}
